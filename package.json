
{
  "name": "servicio-node-clientes",
  "version": "1.0.0",
  "description": "Backend Node.js + Express con SQL Server para gestión de clientes",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:frontend": "cd angular-app && npm start",
    "start:dev": "concurrently \"npm run dev\" \"npm run start:frontend\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mssql": "^11.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4"
  }
}